rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Donations folder: Anyone logged in can read, but only donor can upload
    match /donations/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024 // 5MB limit
                   && request.resource.contentType.matches('image/.*');
    }

    // Profiles folder: User can write their own profile pic
    match /profiles/{userId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024 // 2MB limit
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
