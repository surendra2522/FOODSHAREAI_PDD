<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FoodShareAI E2E Test Suite" verbose="2" parallel="false">
    <listeners>
        <listener class-name="com.foodshareai.listeners.TestListener"/>
        <listener class-name="com.foodshareai.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Authentication Tests">
        <classes>
            <class name="com.foodshareai.authentication.LoginTest"/>
        </classes>
    </test>

    <test name="Donor Workflow Tests">
        <classes>
            <class name="com.foodshareai.donor.DonorWorkflowTest"/>
        </classes>
    </test>

    <test name="NGO Workflow Tests">
        <classes>
            <class name="com.foodshareai.ngo.NGOWorkflowTest"/>
        </classes>
    </test>

    <test name="Admin Dashboard Tests">
        <classes>
            <class name="com.foodshareai.admin.AdminDashboardTest"/>
        </classes>
    </test>

    <test name="AI Food Verification Tests">
        <classes>
            <class name="com.foodshareai.e2e.AiVerificationTest"/>
        </classes>
    </test>

    <test name="Map Navigation & Live Tracking Tests">
        <classes>
            <class name="com.foodshareai.navigation.MapTrackingTest"/>
        </classes>
    </test>

    <test name="User Profile & Settings Tests">
        <classes>
            <class name="com.foodshareai.profile.ProfileAndSettingsTest"/>
        </classes>
    </test>

    <test name="Notification & Chat Tests">
        <classes>
            <class name="com.foodshareai.notifications.NotificationTest"/>
        </classes>
    </test>

    <test name="Security & Permissions Tests">
        <classes>
            <class name="com.foodshareai.permissions.SecurityAndPermissionsTest"/>
        </classes>
    </test>

    <test name="Offline Mode & Resilience Tests">
        <classes>
            <class name="com.foodshareai.integration.OfflineResilienceTest"/>
        </classes>
    </test>
</suite>
